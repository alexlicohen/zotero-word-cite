# zotero-word-cite configuration.
# Copy this file to ".env" and fill in your values:   cp .env.example .env
# .env is gitignored — NEVER commit your real API key.

# ---------------------------------------------------------------------------
# Required for any Zotero operation
# ---------------------------------------------------------------------------
# Create a key at  https://www.zotero.org/settings/keys
#   -> "Create new private key"
#   -> enable BOTH "Allow library access" (read) AND "Allow write access"
#      (writing is required to import EndNote references into your library)
#   -> if using a group, grant the key access to that group.
ZOTERO_API_KEY=

# Your library. Prefer a GROUP library (shared, collaborative).
# Find the numeric group ID in the group URL:
#   https://www.zotero.org/groups/<GROUP_ID>/your-group-name
# (also shown under Group Settings -> Library).
ZOTERO_GROUP_ID=

# Fallback: your PERSONAL library. Only used when ZOTERO_GROUP_ID is empty.
# Your numeric userID is shown on the API-keys page above ("Your userID for
# use in API calls is NNNNNN").
ZOTERO_USER_ID=

# ---------------------------------------------------------------------------
# Optional — politer / faster external lookups (Crossref, PubMed)
# ---------------------------------------------------------------------------
# A contact email puts requests in the API "polite pool". Recommended, not required.
ZOTERO_WORD_CITE_CONTACT_EMAIL=

# NCBI / Entrez (PubMed). Optional; raises your rate limit for PMID lookups.
NCBI_API_KEY=
NCBI_EMAIL=
